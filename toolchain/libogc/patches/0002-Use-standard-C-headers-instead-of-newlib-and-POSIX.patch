From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Sat, 10 Oct 2026 12:35:54 +0200
Subject: [PATCH] Use standard C headers instead of newlib and POSIX dependencies

Include stddef.h explicitly for size_t instead of relying on newlib's
stdint.h. Use time.h for struct timespec, remove unused POSIX and network
includes, and use timespec for network select timeouts.
---
 gc/gctypes.h        | 1 +
 gc/network.h        | 5 ++---
 gc/ogcsys.h         | 1 -
 libogc/network_wii.c | 4 ++--
 libogc/timesupp.c   | 2 +-
 libogc/usbstorage.c | 2 +-
 libogc/wiilaunch.c  | 1 -
 wiiuse/events.c    | 2 --
 8 files changed, 7 insertions(+), 11 deletions(-)

diff --git a/gc/gctypes.h b/gc/gctypes.h
index 0e53704..41fbf9d 100644
--- a/gc/gctypes.h
+++ b/gc/gctypes.h
@@ -7,6 +7,7 @@
 */ 
 
 #include <stdbool.h>
+#include <stddef.h>
 #include <stdint.h>
 
 #ifdef __cplusplus
diff --git a/gc/ogcsys.h b/gc/ogcsys.h
--- a/gc/ogcsys.h
+++ b/gc/ogcsys.h
@@ -2,7 +2,6 @@
 #define __OGCSYS_H__
 
 #include <gccore.h>
-#include <sys/types.h>
 
 #if defined(HW_RVL)
 	#define TB_BUS_CLOCK				243000000u
diff --git a/libogc/timesupp.c b/libogc/timesupp.c
--- a/libogc/timesupp.c
+++ b/libogc/timesupp.c
@@ -11,7 +11,7 @@
 #include "conf.h"
 
 #include <stdio.h>
-#include <sys/time.h>
+#include <time.h>
 
 #include "lwp_threads.inl"
 #include "lwp_watchdog.inl"
diff --git a/libogc/usbstorage.c b/libogc/usbstorage.c
--- a/libogc/usbstorage.c
+++ b/libogc/usbstorage.c
@@ -34,7 +34,7 @@
 #include <string.h>
 #include <unistd.h>
 #include <stdarg.h>
-#include <sys/time.h>
+#include <time.h>
 #include <errno.h>
 #include <lwp_heap.h>
 #include <malloc.h>
diff --git a/libogc/wiilaunch.c b/libogc/wiilaunch.c
--- a/libogc/wiilaunch.c
+++ b/libogc/wiilaunch.c
@@ -38,7 +38,6 @@
 #include "processor.h"
 #include "es.h"
 #include "video.h"
-#include "network.h"
 #include "wiilaunch.h"
 
 static char __nandbootinfo[] ATTRIBUTE_ALIGN(32) = "/shared2/sys/NANDBOOTINFO";
diff --git a/wiiuse/events.c b/wiiuse/events.c
--- a/wiiuse/events.c
+++ b/wiiuse/events.c
@@ -1,14 +1,12 @@
 #include <stdio.h>
 
 #ifndef WIN32
-	#include <sys/time.h>
 	#include <unistd.h>
 	#include <errno.h>
 #else
 	#include <winsock2.h>
 #endif
 
-#include <sys/types.h>
 #include <stdlib.h>
 #include <math.h>
 #include <string.h>
diff --git a/gc/network.h b/gc/network.h
--- a/gc/network.h
+++ b/gc/network.h
@@ -2,8 +2,7 @@
 #define __NETWORK_H__
 
 #include <gctypes.h>
-#include <sys/time.h>
-#include <sys/types.h>
+#include <time.h>
 
 #define INVALID_SOCKET	(~0)
 #define SOCKET_ERROR	(-1)
@@ -275,7 +274,7 @@
 s32 net_recvfrom(s32 s,void *mem,s32 len,u32 flags,struct sockaddr *from,socklen_t *fromlen);
 s32 net_read(s32 s,void *mem,s32 len);
 s32 net_close(s32 s);
-s32 net_select(s32 maxfdp1,fd_set *readset,fd_set *writeset,fd_set *exceptset,struct timeval *timeout);
+s32 net_select(s32 maxfdp1,fd_set *readset,fd_set *writeset,fd_set *exceptset,struct timespec *timeout);
 s32 net_getsockopt(s32 s,u32 level,u32 optname,const void *optval,socklen_t optlen);
 s32 net_setsockopt(s32 s,u32 level,u32 optname,const void *optval,socklen_t optlen);
 s32 net_getsockname(s32 s, struct sockaddr *addr, socklen_t *addrlen);
diff --git a/libogc/network_wii.c b/libogc/network_wii.c
--- a/libogc/network_wii.c
+++ b/libogc/network_wii.c
@@ -1069,7 +1069,7 @@
 	return ret;
 }
 
-s32 net_select(s32 maxfdp1, fd_set *readset, fd_set *writeset, fd_set *exceptset, struct timeval *timeout)
+s32 net_select(s32 maxfdp1, fd_set *readset, fd_set *writeset, fd_set *exceptset, struct timespec *timeout)
 {
     struct pollsd sds[FD_SETSIZE];
     int i, n_sds = 0;
@@ -1098,7 +1098,7 @@
         }
     }
 
-    timeout_msecs = timeout->tv_sec * 1000 + timeout->tv_usec / 1000;
+    timeout_msecs = timeout->tv_sec * 1000 + timeout->tv_nsec / 1000000;
     ret = net_poll(sds, n_sds, timeout_msecs);
     if (ret <= 0) return ret;
 
