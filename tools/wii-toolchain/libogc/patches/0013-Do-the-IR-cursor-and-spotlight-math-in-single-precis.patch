From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Sat, 10 Oct 2026 12:51:11 +0200
Subject: [PATCH] Do the IR cursor and spotlight math in single precision

Double constants made these float calculations use double precision, which
is slower on the PowerPC 750 and needs conversions back to float.

Use explicit float math functions instead of relying on libc aliases.
---
 libogc/gx.c |  2 +-
 wiiuse/ir.c | 16 ++++++++--------
 2 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/libogc/gx.c b/libogc/gx.c
index 8cace00..735e110 100644
--- a/libogc/gx.c
+++ b/libogc/gx.c
@@ -4809,7 +4809,7 @@ void GX_InitLightSpot(GXLightObj *lit_obj,f32 cut_off,
 
 	if(cut_off<0.0f ||	cut_off>90.0f) spotfn = GX_SP_OFF;
 
-	r = (cut_off*M_PI)/180.0f;
+	r = (cut_off*(f32)M_PI)/180.0f;
 	cr = cosf(r);
 
 	switch(spotfn) {
diff --git a/wiiuse/ir.c b/wiiuse/ir.c
index d9659f5..5487ee2 100644
--- a/wiiuse/ir.c
+++ b/wiiuse/ir.c
@@ -64,8 +64,8 @@ static void rotate_dots(struct fdot_t* in, struct fdot
 		return;
 	}
 
-	s = sin(DEGREE_TO_RAD(ang));
-	c = cos(DEGREE_TO_RAD(ang));
+	s = sinf(DEGREE_TO_RAD(ang));
+	c = cosf(DEGREE_TO_RAD(ang));
 
 	/*
 	 *	[ cos(theta)  -sin(theta) ][ ir->rx ]
@@ -559,7 +559,7 @@ void find_sensorbar(struct ir_t* ir, struct orient_t *
 					continue;
 				WIIUSE_DEBUG("IR: passed angle check\n");
 				// rotate to the true sensor bar angle
-				cand.off_angle = -RAD_TO_DEGREE(atan2(difference.y, difference.x));
+				cand.off_angle = -RAD_TO_DEGREE(atan2f(difference.y, difference.x));
 				cand.angle = cand.off_angle + orient->roll;
 				rotate_dots(cand.dots, cand.rot_dots, 2, cand.angle);
 				WIIUSE_DEBUG("IR: off_angle: %.02f, angle: %.02f\n", cand.off_angle, cand.angle);
@@ -649,7 +649,7 @@ void find_sensorbar(struct ir_t* ir, struct orient_t *
 					} else {
 						// calculate the rotated dots frame
 						// angle tends to drift, so recalculate
-						sb.off_angle = -RAD_TO_DEGREE(atan2(sb.acc_dots[1].y - sb.acc_dots[0].y, sb.acc_dots[1].x - sb.acc_dots[0].x));
+						sb.off_angle = -RAD_TO_DEGREE(atan2f(sb.acc_dots[1].y - sb.acc_dots[0].y, sb.acc_dots[1].x - sb.acc_dots[0].x));
 						sb.angle = ir->sensorbar.off_angle + orient->roll;
 						rotate_dots(sb.acc_dots, sb.rot_dots, 2, ir->sensorbar.off_angle);
 						WIIUSE_DEBUG("IR: kept track of single dot\n");
@@ -685,7 +685,7 @@ void find_sensorbar(struct ir_t* ir, struct orient_t *
 					sb = sbx[1];
 				}
 				// angle tends to drift, so recalculate
-				sb.off_angle = -RAD_TO_DEGREE(atan2(sb.acc_dots[1].y - sb.acc_dots[0].y, sb.acc_dots[1].x - sb.acc_dots[0].x));
+				sb.off_angle = -RAD_TO_DEGREE(atan2f(sb.acc_dots[1].y - sb.acc_dots[0].y, sb.acc_dots[1].x - sb.acc_dots[0].x));
 				sb.angle = ir->sensorbar.off_angle + orient->roll;
 				rotate_dots(sb.acc_dots, sb.rot_dots, 2, ir->sensorbar.off_angle);
 				WIIUSE_DEBUG("IR: found new dot to track\n");
@@ -711,10 +711,10 @@ void find_sensorbar(struct ir_t* ir, struct orient_t *
 	}
 
 	ir->raw_valid = 1;
-	ir->ax = ((sb.rot_dots[0].x + sb.rot_dots[1].x) / 2) * 512.0 + 512.0;
-	ir->ay = ((sb.rot_dots[0].y + sb.rot_dots[1].y) / 2) * 512.0 + 384.0;
+	ir->ax = ((sb.rot_dots[0].x + sb.rot_dots[1].x) / 2) * 512.0f + 512.0f;
+	ir->ay = ((sb.rot_dots[0].y + sb.rot_dots[1].y) / 2) * 512.0f + 384.0f;
 	ir->sensorbar = sb;
-	ir->distance = (sb.rot_dots[1].x - sb.rot_dots[0].x) * 512.0;
+	ir->distance = (sb.rot_dots[1].x - sb.rot_dots[0].x) * 512.0f;
 
 }
 
