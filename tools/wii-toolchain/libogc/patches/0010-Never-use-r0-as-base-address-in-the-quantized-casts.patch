From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Sat, 10 Oct 2026 12:35:54 +0200
Subject: [PATCH] Never use r0 as base address in the quantized casts

The paired single loads and stores read r0 as zero, the "b" constraint
keeps the compiler from picking it.
---
 gc/ogc/cast.h | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/gc/ogc/cast.h b/gc/ogc/cast.h
index 7de5035..ae2b555 100644
--- a/gc/ogc/cast.h
+++ b/gc/ogc/cast.h
@@ -98,7 +98,7 @@ static inline f32 __castu8f32( u8 *in)
 {
 	 f32 rval;
 	__asm__ __volatile__ (
-		"psq_l	%[rval],0,%[in],1,2" : [rval]"=f"(rval) : [in]"r"(in)
+		"psq_l	%[rval],0,%[in],1,2" : [rval]"=f"(rval) : [in]"b"(in)
 	);
 	return rval;
 }
@@ -107,7 +107,7 @@ static inline f32 __castu16f32( u16 *in)
 {
 	 f32 rval;
 	__asm__ __volatile__ (
-		"psq_l	%[rval],0,%[in],1,3" : [rval]"=f"(rval) : [in]"r"(in)
+		"psq_l	%[rval],0,%[in],1,3" : [rval]"=f"(rval) : [in]"b"(in)
 	);
 	return rval;
 }
@@ -116,7 +116,7 @@ static inline f32 __casts8f32( s8 *in)
 {
 	 f32 rval;
 	__asm__ __volatile__ (
-		"psq_l	%[rval],0,%[in],1,4" : [rval]"=f"(rval) : [in]"r"(in)
+		"psq_l	%[rval],0,%[in],1,4" : [rval]"=f"(rval) : [in]"b"(in)
 	);
 	return rval;
 }
@@ -125,7 +125,7 @@ static inline f32 __casts16f32( s16 *in)
 {
 	 f32 rval;
 	__asm__ __volatile__ (
-		"psq_l	%[rval],0,%[in],1,5" : [rval]"=f"(rval) : [in]"r"(in)
+		"psq_l	%[rval],0,%[in],1,5" : [rval]"=f"(rval) : [in]"b"(in)
 	);
 	return rval;
 }
