                        { "root": "localAppData", "path": "Microsoft/Teams/Code Cache" },
                        { "root": "localAppData", "path": "Microsoft/Teams/GPUCache" },
                        {
                            "root": "localAppData",
                            "path": "Packages/MSTeams_8wekyb3d8bbwe/LocalCache/Microsoft/MSTeams/EBWebView/*/Cache"
                        },
                        {
                            "root": "localAppData",
                            "path": "Packages/MSTeams_8wekyb3d8bbwe/LocalCache/Microsoft/MSTeams/EBWebView/*/Code Cache"
                        },
                        {
                            "root": "localAppData",
