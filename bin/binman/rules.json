                        { "root": "localAppData", "path": "Microsoft/VisualStudio/*/MEFCacheBackup" },
                        { "root": "localAppData", "path": "Microsoft/VisualStudio/*/ImageLibrary" },
                        { "root": "localAppData", "path": "Microsoft/VisualStudio/WebView2Cache" }
                    ]
                },
                {
                    "id": "jetbrains-cache",
                    "name": "JetBrains IDEs",
                    "description": "IDE indexes and caches; projects, plugins and settings are preserved.",
                    "processNames": ["idea64.exe", "clion64.exe", "pycharm64.exe", "rider64.exe", "webstorm64.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "JetBrains/*/caches" },
                        { "root": "localAppData", "path": "JetBrains/*/index" }
                    ]
                },
                {
                    "id": "android-cache",
                    "name": "Android tooling",
                    "description": "Android SDK metadata and emulator download caches; SDKs and virtual devices are preserved.",
                    "processNames": ["studio64.exe", "emulator.exe"],
                    "kind": "paths",
                    "rules": [{ "root": "userProfile", "path": ".android/cache" }]
                },
                {
                    "id": "playwright-cache",
                    "name": "Playwright browsers",
                    "description": "Downloaded test browsers; Playwright downloads them again when required.",
                    "kind": "paths",
                    "rules": [{ "root": "localAppData", "path": "ms-playwright" }]
                },
                {
                    "id": "docker-build-cache",
                    "name": "Docker build cache",
                    "description": "Unused BuildKit build cache reported and removed by Docker; images, containers and volumes are preserved.",
                    "kind": "dockerBuildCache"
                },
                {
                    "id": "uv-cache",
                    "name": "uv",
                    "description": "Downloaded Python packages and build artifacts managed by uv; environments and projects are preserved.",
                    "processNames": ["uv.exe"],
                    "kind": "uvCache"
                },
                {
                    "id": "cypress-cache",
                    "name": "Cypress browsers",
                    "description": "Downloaded Cypress test runners; Cypress downloads them again when required.",
                    "processNames": ["Cypress.exe"],
                    "kind": "paths",
                    "rules": [{ "root": "localAppData", "path": "Cypress/Cache" }]
                },
                {
                    "id": "bun-cache",
                    "name": "Bun",
                    "description": "Downloaded Bun package cache; projects and globally installed packages are preserved.",
                    "processNames": ["bun.exe"],
                    "kind": "paths",
                    "rules": [{ "root": "userProfile", "path": ".bun/install/cache" }]
                },
                {
                    "id": "composer-cache",
                    "name": "Composer",
                    "description": "Downloaded PHP packages and repository metadata; projects and credentials are preserved.",
                    "processNames": ["php.exe", "composer.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "Composer/files" },
                        { "root": "localAppData", "path": "Composer/repo" }
                    ]
                },
                {
                    "id": "unreal-engine-cache",
                    "name": "Unreal Engine derived data",
                    "description": "Shared derived asset data; Unreal Engine recompiles it, so the next editor or game launch can be slower.",
                    "processNames": ["UnrealEditor.exe", "UE4Editor.exe"],
                    "kind": "paths",
                    "rules": [{ "root": "localAppData", "path": "UnrealEngine/Common/DerivedDataCache" }]
                },
                {
                    "id": "unity-cache",
                    "name": "Unity asset cache",
                    "description": "Downloaded and generated Unity asset cache; projects are preserved and missing data is regenerated.",
                    "processNames": ["Unity.exe", "Unity Hub.exe"],
                    "kind": "paths",
                    "rules": [{ "root": "localAppData", "path": "Unity/cache" }]
                }
            ]
        }
    ]
}
