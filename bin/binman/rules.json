                    "kind": "paths",
                    "rules": [{ "root": "programFilesX86", "path": "Steam/steamapps/shadercache" }]
                },
                {
                    "id": "vscode-cache",
                    "name": "Visual Studio Code",
                    "description": "Editor, code and GPU caches; projects and settings are preserved.",
                    "defaultSelected": true,
                    "processNames": ["code.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "roamingAppData", "path": "Code/Cache" },
                        { "root": "roamingAppData", "path": "Code/CachedData" },
                        { "root": "roamingAppData", "path": "Code/Code Cache" },
                        { "root": "roamingAppData", "path": "Code/GPUCache" }
                    ]
                },
                {
                    "id": "slack-cache",
                    "name": "Slack",
                    "description": "Slack web, code and GPU caches; workspaces and sign-ins are preserved.",
                    "defaultSelected": true,
                    "processNames": ["slack.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "roamingAppData", "path": "Slack/Cache" },
                        { "root": "roamingAppData", "path": "Slack/Code Cache" },
                        { "root": "roamingAppData", "path": "Slack/GPUCache" }
                    ]
                },
