                    "processNames": ["discord.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "roamingAppData", "path": "discord/Cache" },
                        { "root": "roamingAppData", "path": "discord/Code Cache" },
                        { "root": "roamingAppData", "path": "discord/GPUCache" }
                    ]
                },
                {
                    "id": "spotify-cache",
                    "name": "Spotify",
                    "description": "Spotify browser and graphics caches; downloaded music is preserved.",
