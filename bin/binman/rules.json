                            "root": "localAppData",
                            "path": "Packages/5319275A.WhatsAppDesktop_*/LocalCache/Roaming/WhatsApp/Cache"
                        },
                        {
                            "root": "localAppData",
                            "path": "Packages/5319275A.WhatsAppDesktop_*/LocalCache/Roaming/WhatsApp/Code Cache"
