                    "description": "Profile web and startup caches; browsing data and sign-ins are preserved.",
                    "defaultSelected": true,
                    "processNames": ["firefox.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "Mozilla/Firefox/Profiles/*/cache2" },
                        { "root": "localAppData", "path": "Mozilla/Firefox/Profiles/*/startupCache" }
                    ]
                },
                {
                    "id": "brave-cache",
                    "name": "Brave",
                    "description": "Web, code, GPU and shader caches; browsing data and sign-ins are preserved.",
                    "defaultSelected": true,
                    "processNames": ["brave.exe"],
