{
    "version": 1,
    "groups": [
        {
            "id": "windows",
            "name": "Windows",
            "rules": [
                {
                    "id": "windows-user-temp",
                    "name": "Temporary files",
                    "description": "Temporary files created by your account and applications.",
                    "defaultSelected": true,
                    "kind": "paths",
                    "rules": [{ "root": "localAppData", "path": "Temp" }]
                },
                {
                    "id": "windows-system-temp",
                    "name": "Windows temporary files",
                    "description": "Temporary working files created by Windows services.",
                    "defaultSelected": true,
                    "requiresAdministrator": true,
                    "kind": "paths",
                    "rules": [{ "root": "windows", "path": "Temp" }]
                },
                {
                    "id": "windows-error-reports",
                    "name": "Error reports",
                    "description": "Archived and queued Windows Error Reporting data.",
                    "defaultSelected": true,
                    "requiresAdministrator": true,
                    "kind": "paths",
                    "rules": [
                        { "root": "programData", "path": "Microsoft/Windows/WER/ReportArchive" },
                        { "root": "programData", "path": "Microsoft/Windows/WER/ReportQueue" },
                        { "root": "localAppData", "path": "Microsoft/Windows/WER" }
                    ]
                },
                {
                    "id": "windows-crash-dumps",
                    "name": "Crash dumps",
                    "description": "Application crash dumps and Windows minidumps used for diagnostics.",
                    "defaultSelected": true,
                    "requiresAdministrator": true,
                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "CrashDumps" },
                        { "root": "windows", "path": "Minidump" },
                        { "root": "windows", "path": "memory.dmp" }
                    ]
                },
                {
                    "id": "windows-directx-cache",
                    "name": "DirectX shader cache",
                    "description": "Compiled graphics shaders that Windows recreates when needed.",
                    "defaultSelected": true,
                    "kind": "paths",
                    "rules": [{ "root": "localAppData", "path": "D3DSCache" }]
                },
                {
                    "id": "gpu-shader-caches",
                    "name": "GPU shader caches",
                    "description": "NVIDIA, AMD and Intel compiled shader caches; graphics drivers recreate them.",
                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "NVIDIA/DXCache" },
                        { "root": "localAppData", "path": "NVIDIA/GLCache" },
                        { "root": "userProfile", "path": ".nv/ComputeCache" },
                        { "root": "localAppData", "path": "AMD/DxCache" },
                        { "root": "localAppData", "path": "AMD/GLCache" },
                        { "root": "localAppData", "path": "Intel/ShaderCache" }
                    ]
                },
                {
                    "id": "windows-app-temp-state",
                    "name": "Microsoft Store app temporary files",
                    "description": "Temporary-state folders from Store apps; local settings and offline data are preserved.",
                    "kind": "paths",
                    "rules": [{ "root": "localAppData", "path": "Packages/*/TempState" }]
                },
                {
                    "id": "windows-thumbnail-cache",
                    "name": "Thumbnail and icon cache",
                    "description": "Explorer previews and icons that are regenerated automatically.",
                    "defaultSelected": true,
                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "Microsoft/Windows/Explorer/thumbcache_*.db" },
                        { "root": "localAppData", "path": "Microsoft/Windows/Explorer/iconcache_*.db" }
                    ]
                },
                {
                    "id": "windows-update-downloads",
                    "name": "Windows Update downloads",
                    "description": "Downloaded update installers; Windows downloads them again if required.",
                    "requiresAdministrator": true,
                    "kind": "windowsUpdate"
                },
                {
                    "id": "windows-delivery-optimization",
                    "name": "Delivery Optimization cache",
                    "description": "Locally cached Windows update delivery data.",
                    "requiresAdministrator": true,
                    "kind": "deliveryOptimization"
                },
                {
                    "id": "windows-component-store",
                    "name": "Windows component cleanup",
                    "description": "Microsoft DISM cleanup that preserves update uninstall support.",
                    "requiresAdministrator": true,
                    "kind": "dismComponentStore"
                },
                {
                    "id": "windows-recycle-bin",
                    "name": "Recycle Bin",
                    "description": "Permanently removes files currently stored in the Recycle Bin.",
                    "kind": "recycleBin"
                }
            ]
        },
        {
            "id": "browsers",
            "name": "Browsers",
            "rules": [
                {
                    "id": "edge-cache",
                    "name": "Microsoft Edge",
                    "description": "Web, code and GPU caches; browsing data and sign-ins are preserved.",
