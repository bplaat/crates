                        { "root": "localAppData", "path": "Google/Chrome/User Data/GrShaderCache" },
                        { "root": "localAppData", "path": "Google/Chrome/User Data/GraphiteDawnCache" }
                    ]
                },
                {
                    "id": "firefox-cache",
