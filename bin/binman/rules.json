                    "processNames": ["spotify.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "Spotify/Browser/Cache" },
                        { "root": "localAppData", "path": "Spotify/Browser/Code Cache" },
                        { "root": "localAppData", "path": "Spotify/Browser/GPUCache" }
                    ]
                },
                {
                    "id": "steam-cache",
                    "name": "Steam",
                    "description": "Steam web caches; installed games and active downloads are preserved.",
                    "defaultSelected": true,
                    "processNames": ["steam.exe", "steamwebhelper.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "programFilesX86", "path": "Steam/config/htmlcache" },
                        { "root": "localAppData", "path": "Steam/htmlcache" }
                    ]
                },
                {
                    "id": "steam-shader-cache",
