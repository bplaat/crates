                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "Microsoft/Edge/User Data/*/Cache" },
                        { "root": "localAppData", "path": "Microsoft/Edge/User Data/*/Code Cache" },
                        { "root": "localAppData", "path": "Microsoft/Edge/User Data/*/GPUCache" },
                        { "root": "localAppData", "path": "Microsoft/Edge/User Data/ShaderCache" },
                        { "root": "localAppData", "path": "Microsoft/Edge/User Data/GrShaderCache" },
                        { "root": "localAppData", "path": "Microsoft/Edge/User Data/GraphiteDawnCache" }
                    ]
                },
                {
                    "id": "chrome-cache",
                    "name": "Google Chrome",
                    "description": "Web, code and GPU caches; browsing data and sign-ins are preserved.",
