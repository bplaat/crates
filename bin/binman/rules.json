                        { "root": "localAppData", "path": "BraveSoftware/Brave-Browser/User Data/ShaderCache" },
                        { "root": "localAppData", "path": "BraveSoftware/Brave-Browser/User Data/GrShaderCache" },
                        { "root": "localAppData", "path": "BraveSoftware/Brave-Browser/User Data/GraphiteDawnCache" }
                    ]
                },
                {
                    "id": "opera-cache",
                    "name": "Opera",
                    "description": "Web, code and GPU caches for stable and preview installations.",
                    "defaultSelected": true,
                    "processNames": ["opera.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "roamingAppData", "path": "Opera Software/Opera*/Cache" },
                        { "root": "roamingAppData", "path": "Opera Software/Opera*/Code Cache" },
                        { "root": "roamingAppData", "path": "Opera Software/Opera*/GPUCache" },
                        { "root": "roamingAppData", "path": "Opera Software/Opera*/ShaderCache" }
                    ]
                },
                {
                    "id": "vivaldi-cache",
                    "name": "Vivaldi",
                    "description": "Web, code, GPU and shader caches; browsing data and sign-ins are preserved.",
                    "defaultSelected": true,
                    "processNames": ["vivaldi.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "Vivaldi/User Data/*/Cache" },
                        { "root": "localAppData", "path": "Vivaldi/User Data/*/Code Cache" },
                        { "root": "localAppData", "path": "Vivaldi/User Data/*/GPUCache" },
                        { "root": "localAppData", "path": "Vivaldi/User Data/ShaderCache" },
                        { "root": "localAppData", "path": "Vivaldi/User Data/GrShaderCache" }
                    ]
                },
                {
                    "id": "chromium-cache",
                    "name": "Chromium",
                    "description": "Web, code, GPU and shader caches; browsing data and sign-ins are preserved.",
                    "processNames": ["chromium.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "Chromium/User Data/*/Cache" },
                        { "root": "localAppData", "path": "Chromium/User Data/*/Code Cache" },
                        { "root": "localAppData", "path": "Chromium/User Data/*/GPUCache" },
                        { "root": "localAppData", "path": "Chromium/User Data/ShaderCache" }
                    ]
                },
                {
                    "id": "thunderbird-cache",
                    "name": "Mozilla Thunderbird",
                    "description": "Web and startup caches; mail, accounts and saved credentials are preserved.",
                    "defaultSelected": true,
                    "processNames": ["thunderbird.exe"],
                    "kind": "paths",
                    "rules": [
                        { "root": "localAppData", "path": "Thunderbird/Profiles/*/cache2" },
                        { "root": "localAppData", "path": "Thunderbird/Profiles/*/startupCache" }
                    ]
                }
            ]
        },
        {
            "id": "applications",
            "name": "Applications",
            "rules": [
                {
                    "id": "teams-cache",
                    "name": "Microsoft Teams",
                    "description": "Teams webview caches without removing accounts or conversations.",
                    "defaultSelected": true,
                    "processNames": ["ms-teams.exe", "teams.exe"],
